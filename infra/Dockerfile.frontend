# SchoolAutomaton frontend — build the Vue SPA, serve it with nginx (which also proxies /api).
# node:24 = current Active LTS (node 20 is end-of-life); nginx 1.30 = current stable line, -slim
# variant (core modules only — all this config uses — and far fewer OS packages to patch).
# update.sh builds with --pull, so patch/security releases of both arrive automatically.
FROM node:24-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
# Exactly what package-lock.json says (fails if it is out of sync with package.json).
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM nginx:1.30-alpine-slim
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
COPY infra/nginx-security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /app/dist /usr/share/nginx/html
# A config error fails the image build, so update.sh never deploys it.
RUN nginx -t
EXPOSE 80
