# ============================================================================
#  SchoolAutomaton — environment configuration. Copy to .env and fill in.
#  Everything with a sane default can be left unset for local dev.
# ============================================================================

# ---- Provider credentials (REQUIRED for generation to work) ----
ANTHROPIC_API_KEY=sk-ant-...
REPLICATE_API_TOKEN=r8_...

# ---- Secrets (REQUIRED in production) ----
# APP_SECRET: master secret. Used to derive the JWT signing key and the Fernet
# key that encrypts API keys / flagged raw audit text at rest. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=change-me-please-a-long-random-string

# ---- Bootstrap admin (created on first boot if no admin exists) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# ---- Models ----
# Leave these commented out to follow the app's defaults (claude-opus-5-5 / claude-haiku-5-5),
# so an update can move them. Set them only to pin a model on purpose. (An admin can also switch
# models at runtime: /admin → Settings; a change there wins over these lines.)
# SA_MODEL_ID=claude-opus-5-5
# SA_SANITIZER_MODEL_ID=claude-haiku-5-5

# ---- Runtime ----
SA_ENV=development                 # development | production
SA_DEBUG=true
SA_DATABASE_URL=sqlite+aiosqlite:///./data/schoolautomaton.db
SA_DATA_DIR=./data
# Browser-facing origin(s). Local dev defaults below; in production set your public URL, e.g.
#   SA_CORS_ORIGINS=https://schoolautomaton.avercode.com
SA_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Safety / audit ----
SA_RAW_CAPTURE_ON_FLAG=false       # retain Fernet-encrypted raw text ONLY for safety-flagged events
SA_AUDIT_RAW_RETENTION_DAYS=30

# ---- Rate limiting ----
# Generation (prompts / generation starts / section fills): per learner when the request carries a
# valid resume code, else per IP. Every IP also has a ceiling of SA_RATE_IP_MULTIPLIER x these, so a
# classroom behind one school NAT works while code rotation can't lift one machine past it.
SA_RATE_PER_MIN=20
SA_RATE_PER_DAY=300
SA_RATE_IP_MULTIPLIER=10
SA_ANSWER_RATE_PER_MIN=60          # answers + reviews per learner per minute
SA_ANSWER_LLM_RATE_PER_MIN=20      # ...of which AI-graded (free-text) answers
SA_PROFILE_CREATE_PER_HOUR=60      # new anonymous profiles per IP per hour
SA_RESUME_FAIL_LIMIT=30            # distinct unknown resume codes per IP per window, then 429
SA_RESUME_FAIL_WINDOW_S=600
SA_ADMIN_LOGIN_FAIL_LIMIT=5        # failed admin logins per minute (per IP / username) -> lockout

# ---- Cost guardrails ----
SA_VIDEO_ENABLED=false             # opt-in Replicate image-to-video (quota-gated, off by default)
SA_DAILY_VIDEO_QUOTA=0
SA_DAILY_BUDGET_USD=100            # global AI spend cap per UTC day (estimated); 0 disables

# ---- Frontend (used by Vite at build/dev) ----
VITE_API_BASE=/api/v1

# ---- Server deployment (Docker Compose, behind your Cloudflare tunnel) — see DEPLOY.md ----
# Host port the web app (nginx) is published on. Your Cloudflare tunnel forwards
# schoolautomaton.avercode.com -> http://localhost:SA_HTTP_PORT. Change to any free port.
SA_HTTP_PORT=8080
# Interface to bind the published port to. 127.0.0.1 = local-only (correct when cloudflared runs
# on this same host — the tunnel reaches it privately, nothing is exposed to the internet
# directly). Set 0.0.0.0 only if you also want direct LAN/public access without the tunnel.
SA_HTTP_BIND=127.0.0.1
